+    let to = to_pid.map_or(NFT_NO_TASK, |pid| pid as u64);
+    let record = NfTraceRecord { type_: NFT_SCHED_SWITCH, a: [from, to, from, to] };
+    nftrace_commit_point(&record as *const NfTraceRecord as *const u64);

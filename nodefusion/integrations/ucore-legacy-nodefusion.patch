 extern char ekernel[];
 
@@ -12,6 +13,10 @@ struct {
 	struct linklist *freelist;
 } kmem;
 
+static uint64 nf_free_pages;
+static uint64 nf_used_pages;
+static int nftrace_ready;
+
 void freerange(void *pa_start, void *pa_end)
 {
 	char *p;
@@ -23,6 +28,8 @@ void freerange(void *pa_start, void *pa_end)
 void kinit()
 {
 	freerange(ekernel, (void *)PHYSTOP);
+	nftrace_ready = 1;
+	nftrace_allocator_state(nf_free_pages, nf_used_pages);
 }
 
 // Free the page of physical memory pointed at by v,
@@ -40,6 +47,9 @@ void kfree(void *pa)
 	l = (struct linklist *)pa;
 	l->next = kmem.freelist;
 	kmem.freelist = l;
+	nf_free_pages++;
+	if (nftrace_ready)
+		nftrace_page_free((uint64)pa, 1, nf_free_pages, nf_used_pages);
 }
 
 // Allocate one 4096-byte page of physical memory.
@@ -51,7 +61,11 @@ void *kalloc(void)
 	l = kmem.freelist;
 	if (l) {
 		kmem.freelist = l->next;
+		nf_free_pages--;
+		nf_used_pages++;
 		memset((char *)l, 5, PGSIZE); // fill with junk
 	}
+	if (nftrace_ready)
+		nftrace_page_alloc((uint64)l, 1, nf_free_pages, nf_used_pages);
 	return (void *)l;
 }

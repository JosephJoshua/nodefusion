diff --git a/os/nftrace.c b/os/nftrace.c
new file mode 100644
index 0000000..15df745
--- /dev/null
+++ b/os/nftrace.c
@@ -0,0 +1,29 @@
+#include "nftrace.h"
+
+__attribute__((noinline))
+void nftrace_commit_point(const struct nftrace_record *record)
+{
+	if (record != 0)
+		__asm__ volatile("" : : "r"(*(volatile const uint64 *)record) : "memory");
+}
+
+static inline void emit(uint64 type, uint64 a0, uint64 a1, uint64 a2, uint64 a3)
+{
+	const struct nftrace_record record = { type, { a0, a1, a2, a3 } };
+	nftrace_commit_point(&record);
+}
+
+void nftrace_page_alloc(uint64 pa, uint64 pages, uint64 free_pages, uint64 used_pages)
+{
+	emit(NFT_KALLOC, pa, pages, free_pages, used_pages);
+}
+
+void nftrace_page_free(uint64 pa, uint64 pages, uint64 free_pages, uint64 used_pages)
+{
+	emit(NFT_KFREE, pa, pages, free_pages, used_pages);
+}
+
+void nftrace_allocator_state(uint64 free_pages, uint64 used_pages)
+{
+	emit(NFT_ALLOCATOR_STATE, free_pages, used_pages, 0, 0);
+}
diff --git a/os/nftrace.h b/os/nftrace.h
new file mode 100644
index 0000000..911e355
--- /dev/null
+++ b/os/nftrace.h
@@ -0,0 +1,22 @@
+#ifndef NFTRACE_H
+#define NFTRACE_H
+
+#include "types.h"
+
+enum {
+	NFT_KALLOC = 1,
+	NFT_KFREE = 5,
+	NFT_ALLOCATOR_STATE = 6,
+};
+
+struct nftrace_record {
+	uint64 type;
+	uint64 a[4];
+};
+
+void nftrace_commit_point(const struct nftrace_record *record);
+void nftrace_page_alloc(uint64 pa, uint64 pages, uint64 free_pages, uint64 used_pages);
+void nftrace_page_free(uint64 pa, uint64 pages, uint64 free_pages, uint64 used_pages);
+void nftrace_allocator_state(uint64 free_pages, uint64 used_pages);
+
+#endif

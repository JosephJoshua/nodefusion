+        a: [paddr as u64, 1, free_pages as u64, used_pages as u64],
+    };
+    nftrace_commit_point(&record as *const NfTraceRecord as *const u64);
+}
+
+pub(crate) fn nodefusion_trace_sched_switch(
+    from: Option<(usize, usize)>,
+    to: Option<(usize, usize)>,
+) {
+    let (from_task, from_pid) = from.map_or((NFT_NO_TASK, NFT_NO_TASK),
+        |(task, pid)| (task as u64, pid as u64));
+    let (to_task, to_pid) = to.map_or((NFT_NO_TASK, NFT_NO_TASK),
+        |(task, pid)| (task as u64, pid as u64));
+    let record = NfTraceRecord {
+        type_: NFT_SCHED_SWITCH,
+        a: [from_task, to_task, from_pid, to_pid],
+    };
+    nftrace_commit_point(&record as *const NfTraceRecord as *const u64);
+}

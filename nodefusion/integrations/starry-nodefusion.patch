+/// Report an allocation result after allocator locks have been released.
+#[cfg(feature = "nodefusion-trace")]
+#[inline(always)]
+pub(crate) fn trace_page_alloc(
+    vaddr: usize,
+    num_pages: usize,
+    free_pages: usize,
+    used_pages: usize,
+) {
+    // SAFETY: enabling `nodefusion-trace` is a link-time contract with the
+    // Starry kernel, which exports this allocation-free callback.
+    unsafe { nodefusion_trace_page_alloc(vaddr, num_pages, free_pages, used_pages) }
+}
+
+#[cfg(not(feature = "nodefusion-trace"))]
+#[inline(always)]
+pub(crate) fn trace_page_alloc(
+    _vaddr: usize,
+    _num_pages: usize,
+    _free_pages: usize,
+    _used_pages: usize,
+) {
+}
+
+/// Report a deallocation after allocator locks have been released.
+#[cfg(feature = "nodefusion-trace")]
+#[inline(always)]
+pub(crate) fn trace_page_free(
+    vaddr: usize,
+    num_pages: usize,
+    free_pages: usize,
+    used_pages: usize,
+) {
+    // SAFETY: same link-time contract as `trace_page_alloc`.
+    unsafe { nodefusion_trace_page_free(vaddr, num_pages, free_pages, used_pages) }
+}
+
+#[cfg(not(feature = "nodefusion-trace"))]
+#[inline(always)]
+pub(crate) fn trace_page_free(
+    _vaddr: usize,
+    _num_pages: usize,
+    _free_pages: usize,
+    _used_pages: usize,
+) {
+}
+
+/// Report the exact page-backend state after a byte-allocator mutation.
+#[cfg(feature = "nodefusion-trace")]
+#[inline(always)]
+pub(crate) fn trace_allocator_state(free_pages: usize, used_pages: usize) {
+    // SAFETY: same link-time contract as `trace_page_alloc`.
+    unsafe { nodefusion_trace_allocator_state(free_pages, used_pages) }
+}
+
+#[cfg(not(feature = "nodefusion-trace"))]
+#[inline(always)]
+pub(crate) fn trace_allocator_state(_free_pages: usize, _used_pages: usize) {}
+

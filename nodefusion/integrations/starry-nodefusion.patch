diff --git a/os/StarryOS/kernel/src/nftrace.rs b/os/StarryOS/kernel/src/nftrace.rs
new file mode 100644
index 0000000..f9f803a
--- /dev/null
+++ b/os/StarryOS/kernel/src/nftrace.rs
@@ -0,0 +1,123 @@
+//! NodeFusion's optional in-kernel semantic channel.
+//!
+//! The QEMU plugin watches `nftrace_commit_point` and copies the five-u64
+//! record from guest memory at function entry.  Keep this layout synchronized
+//! with `nodefusion/spec/event-stream.md` section 2.4.
+
+use ax_memory_addr::VirtAddr;
+use ax_runtime::hal::mem::virt_to_phys;
+
+const NFT_KALLOC: u64 = 1;
+const NFT_PROC_FORK: u64 = 2;
+const NFT_THREAD_CREATE: u64 = 3;
+const NFT_SCHED_SWITCH: u64 = 4;
+const NFT_KFREE: u64 = 5;
+const NFT_ALLOCATOR_STATE: u64 = 6;
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct NfTraceRecord {
+    type_: u64,
+    a: [u64; 4],
+}
+
+/// Stable observation point.  The volatile read prevents the record and call
+/// from being optimized away; the plugin observes `record` in a0 before the
+/// function body executes.
+#[unsafe(no_mangle)]
+#[inline(never)]
+pub extern "C" fn nftrace_commit_point(record: *const NfTraceRecord) {
+    if !record.is_null() {
+        // SAFETY: every caller passes a live stack record for this call.
+        core::hint::black_box(unsafe { core::ptr::read_volatile(record) });
+    }
+}
+
+#[inline(always)]
+fn emit(type_: u64, a0: u64, a1: u64) {
+    emit4(type_, a0, a1, 0, 0);
+}
+
+#[inline(always)]
+fn emit4(type_: u64, a0: u64, a1: u64, a2: u64, a3: u64) {
+    let record = NfTraceRecord {
+        type_,
+        a: [a0, a1, a2, a3],
+    };
+    nftrace_commit_point(&record);
+}
+
+/// Called by ax-alloc after all allocator locks have been released.
+#[unsafe(no_mangle)]
+pub extern "C" fn nodefusion_trace_page_alloc(
+    vaddr: usize,
+    num_pages: usize,
+    free_pages: usize,
+    used_pages: usize,
+) {
+    let paddr = if vaddr == 0 {
+        0
+    } else {
+        virt_to_phys(VirtAddr::from(vaddr)).as_usize()
+    };
+    emit4(
+        NFT_KALLOC,
+        paddr as u64,
+        num_pages as u64,
+        free_pages as u64,
+        used_pages as u64,
+    );
+}
+
+/// Called by ax-alloc after all allocator locks have been released.
+#[unsafe(no_mangle)]
+pub extern "C" fn nodefusion_trace_page_free(
+    vaddr: usize,
+    num_pages: usize,
+    free_pages: usize,
+    used_pages: usize,
+) {
+    let paddr = virt_to_phys(VirtAddr::from(vaddr)).as_usize();
+    emit4(
+        NFT_KFREE,
+        paddr as u64,
+        num_pages as u64,
+        free_pages as u64,
+        used_pages as u64,
+    );
+}
+
+/// Called after a byte-heap mutation that may grow or shrink its page backing.
+#[unsafe(no_mangle)]
+pub extern "C" fn nodefusion_trace_allocator_state(free_pages: usize, used_pages: usize) {
+    emit(
+        NFT_ALLOCATOR_STATE,
+        free_pages as u64,
+        used_pages as u64,
+    );
+}
+
+pub(crate) fn clone_created(is_thread: bool, parent_tid: u64, child_tid: u64) {
+    emit(
+        if is_thread {
+            NFT_THREAD_CREATE
+        } else {
+            NFT_PROC_FORK
+        },
+        parent_tid,
+        child_tid,
+    );
+}
+
+pub(crate) fn sched_switch(
+    prev_task_id: u64,
+    next_task_id: u64,
+    prev_tid: u64,
+    next_tid: u64,
+) {
+    let record = NfTraceRecord {
+        type_: NFT_SCHED_SWITCH,
+        a: [prev_task_id, next_task_id, prev_tid, next_tid],
+    };
+    nftrace_commit_point(&record);
+}

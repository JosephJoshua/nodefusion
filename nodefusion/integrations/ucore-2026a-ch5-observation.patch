diff --git a/os/nftrace.c b/os/nftrace.c
new file mode 100644
index 0000000..8d99129
--- /dev/null
+++ b/os/nftrace.c
@@ -0,0 +1,39 @@
+#include "nftrace.h"
+
+__attribute__((noinline))
+void nftrace_commit_point(const struct nftrace_record *record)
+{
+	if (record != 0)
+		__asm__ volatile("" : : "r"(*(volatile const uint64 *)record) : "memory");
+}
+
+static inline void emit(uint64 type, uint64 a0, uint64 a1, uint64 a2, uint64 a3)
+{
+	const struct nftrace_record record = { type, { a0, a1, a2, a3 } };
+	nftrace_commit_point(&record);
+}
+
+void nftrace_page_alloc(uint64 pa, uint64 free_pages, uint64 used_pages)
+{
+	emit(1, pa, 1, free_pages, used_pages);
+}
+
+void nftrace_page_free(uint64 pa, uint64 free_pages, uint64 used_pages)
+{
+	emit(5, pa, 1, free_pages, used_pages);
+}
+
+void nftrace_allocator_state(uint64 free_pages, uint64 used_pages)
+{
+	emit(6, free_pages, used_pages, 0, 0);
+}
+
+void nftrace_proc_fork(uint64 parent, uint64 child)
+{
+	emit(2, parent, child, 0, 0);
+}
+
+void nftrace_sched_switch(uint64 from_task, uint64 to_task, uint64 from_pid, uint64 to_pid)
+{
+	emit(4, from_task, to_task, from_pid, to_pid);
+}

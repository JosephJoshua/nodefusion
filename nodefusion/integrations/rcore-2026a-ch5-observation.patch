diff --git a/os/src/nftrace.rs b/os/src/nftrace.rs
new file mode 100644
index 0000000..933bb39
--- /dev/null
+++ b/os/src/nftrace.rs
@@ -0,0 +1,44 @@
+//! Stack-backed observation records for the QEMU plugin.
+
+pub(crate) const NO_TASK: usize = usize::MAX;
+
+#[repr(C)]
+struct Record {
+    kind: u64,
+    args: [u64; 4],
+}
+
+#[no_mangle]
+#[inline(never)]
+/// Read an observation record while its stack storage is live.
+pub extern "C" fn nftrace_commit_point(record: *const u64) {
+    if !record.is_null() {
+        // The caller keeps this stack record alive until return.
+        core::hint::black_box(unsafe { core::ptr::read_volatile(record) });
+    }
+}
+
+fn emit(kind: u64, args: [u64; 4]) {
+    let record = Record { kind, args };
+    nftrace_commit_point(&record as *const Record as *const u64);
+}
+
+pub(crate) fn page_alloc(pa: usize, free: usize, used: usize) {
+    emit(1, [pa as u64, 1, free as u64, used as u64]);
+}
+
+pub(crate) fn page_free(pa: usize, free: usize, used: usize) {
+    emit(5, [pa as u64, 1, free as u64, used as u64]);
+}
+
+pub(crate) fn allocator_state(free: usize, used: usize) {
+    emit(6, [free as u64, used as u64, 0, 0]);
+}
+
+pub(crate) fn process_fork(parent: usize, child: usize) {
+    emit(2, [parent as u64, child as u64, 0, 0]);
+}
+
+pub(crate) fn sched_switch(from_task: usize, to_task: usize, from_pid: usize, to_pid: usize) {
+    emit(4, [from_task as u64, to_task as u64, from_pid as u64, to_pid as u64]);
+}

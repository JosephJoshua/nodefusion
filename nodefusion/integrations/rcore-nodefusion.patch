+const NFT_KALLOC: u64 = 1;
+const NFT_SCHED_SWITCH: u64 = 4;
+const NFT_KFREE: u64 = 5;
+const NFT_NO_TASK: u64 = u64::MAX;
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct NfTraceRecord {
+    type_: u64,
+    a: [u64; 4],
+}
+
+/// Stable observation point for NodeFusion's optional semantic channel.
+///
+/// The QEMU plugin reads the five-u64 record through the pointer in `a0` at
+/// function entry. The volatile read keeps both the record and call present.
+#[no_mangle]
+#[inline(never)]
+pub extern "C" fn nftrace_commit_point(record: *const u64) {
+    if !record.is_null() {
+        // SAFETY: the sole caller passes a live stack record for this call.
+        core::hint::black_box(unsafe { core::ptr::read_volatile(record) });
+    }
+}
+
+#[inline(always)]
+fn nodefusion_trace_page_alloc(paddr: usize, free_pages: usize, used_pages: usize) {
+    let record = NfTraceRecord {
+        type_: NFT_KALLOC,
+        a: [paddr as u64, 1, free_pages as u64, used_pages as u64],
+    };
+    nftrace_commit_point(&record as *const NfTraceRecord as *const u64);
+}
+
+#[inline(always)]
+fn nodefusion_trace_page_free(paddr: usize, free_pages: usize, used_pages: usize) {
+    let record = NfTraceRecord {
+        type_: NFT_KFREE,
+        a: [paddr as u64, 1, free_pages as u64, used_pages as u64],
+    };
+    nftrace_commit_point(&record as *const NfTraceRecord as *const u64);
+}
+
+pub(crate) fn nodefusion_trace_sched_switch(from_pid: Option<usize>, to_pid: Option<usize>) {
+    let from = from_pid.map_or(NFT_NO_TASK, |pid| pid as u64);
+    let to = to_pid.map_or(NFT_NO_TASK, |pid| pid as u64);
+    let record = NfTraceRecord {
+        type_: NFT_SCHED_SWITCH,
+        // rCore's scheduling identity is its PID in this chapter.
+        a: [from, to, from, to],
+    };
+    nftrace_commit_point(&record as *const NfTraceRecord as *const u64);
+}
